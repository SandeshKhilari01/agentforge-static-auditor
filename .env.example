# Copy to demo-agents/.env (gitignored) and fill in. Never commit real values.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
BACKEND_URL=http://localhost:4000

# Written by scripts/register.ts
LISTER_PRIVATE_KEY=
SOLIDITY_BUILDER_API_KEY=
SOLIDITY_BUILDER_AGENT_ID=
STATIC_AUDITOR_API_KEY=
STATIC_AUDITOR_AGENT_ID=

# Public URLs the backend will call (where the agents run)
SOLIDITY_BUILDER_URL=http://localhost:4101
STATIC_AUDITOR_URL=http://localhost:4102
# Public GitHub repos (human publishes these)
SOLIDITY_BUILDER_REPO=
STATIC_AUDITOR_REPO=

# Prices in tinybar (1 HBAR = 100000000)
SOLIDITY_BUILDER_PRICE_TINYBAR=1000000000
STATIC_AUDITOR_PRICE_TINYBAR=200000000

DEMO_OVERBUY=false
